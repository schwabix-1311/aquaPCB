	(text "5 V / 3 A buck, TPS54360B (TI datasheet SNVSB93 Fig. 32, values moved to JLC basic parts)"
		(exclude_from_sim no)
		(at 25.4 114.3 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "0dc4be50-cf08-4c25-ba50-c91b406c7bf1")
	)
	(text "f_sw = 644 kHz (RT 150k). V_OUT = 0.8 V x (1 + 12k/2.2k) = 5.16 V. EN open = enabled, internal\nUVLO 4.3 V. Catch diode SS54: ~1 W at 3 A / 12 V in, give it copper."
		(exclude_from_sim no)
		(at 25.4 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8c7b368f-36e1-4a14-83c9-6c6edaef00c5")
	)
	(text "JP \"5V→Pi\": close to power the Pi from this board. Leave OPEN when the Pi has its own USB supply\n(always for Pi 5)."
		(exclude_from_sim no)
		(at 25.4 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "975035c5-5f40-4030-8ed8-6c51217213af")
	)
	(text "Q10 body diode conducts first, then the channel turns on (V_GS = -V_IN, clamped to -15 V by the\nzener for 24 V operation). Reversed input: Q10 stays off."
		(exclude_from_sim no)
		(at 25.4 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aed0dbf9-fb3d-498f-8cf9-85cc61ad353c")
	)
	(text "12 V input (24 V ready): fuse, reverse-polarity P-FET, TVS, bulk"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "bbdabf8a-91eb-4efc-949b-0bb5d2f93a6e")
	)
	(text "3.3 V for ADC, sensors, inputs, display (not connected to the Pi's own 3V3)"
