		(layer "F.Cu")
		(uuid "11de7d46-648c-4552-9263-99b9413b2212")
		(at 151.125 132.98 180)
		(descr "Spring clamp (push-button) PCB terminal block, 3.5 mm pitch, staggered pins, 8 A. Holes in both pin rows for every pole, so both stagger phases fit: Ningbo Kangnex WJ250B-3.5-02P-11 (LCSC C8454, pole 1 in the front row) and MAX MX250-3.5-02P-B (LCSC C7470116, pole 1 in the back row); same body, wire entry on the -y face at 0 deg. Pads from LCSC/EasyEDA data and maker drawings, drill 1.2 mm.")
