	)
	(text "Sensor port: 2x4 box header, pin n = Robo-Tank v3 sensor RJ45 pin n\n(pin 1 GND, 2..7 = sensor 6..1, 8 = +5 V); adapter cable to RJ45 wired 1:1."
		(exclude_from_sim no)
		(at 25.4 72.39 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "45fa96c6-0104-41da-bcf7-955d2b2638fa")
	)
	(text "Per input 1k series + BAT54S clamp to 3.3 V: safe for 5 V sensor outputs without jumpers.\nPull-up or pull-down: Raspberry Pi internal pull, set per sensor type in software."
		(exclude_from_sim no)
		(at 25.4 97.79 0)
