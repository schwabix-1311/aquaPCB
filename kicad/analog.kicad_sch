	(text "AIN0..AIN3: four identical 0..5 V sockets +5V_EXT / SIG / GND for add-on modules (pH/ORP etc.).\n10k/20k divider (0..5 V -> 0..3.33 V), 10u low-pass, BAT54S clamp to 3.3 V."
		(exclude_from_sim no)
		(at 25.4 229.108 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "248137cb-c5f9-4bb6-9c29-02d5ad7a0ee5")
	)
	(text "Add-on modules (pH/ORP amplifiers, isolated or not) plug into any socket; the main board has no pH front end."
		(exclude_from_sim no)
		(at 24.892 182.372 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "2e561d45-5ead-48e8-9b99-278c11f0ccde")
	)
	(text "ADS1115 on 3.3 V (I2C levels match the Pi), address 0x48 (JP 1-2, default) or 0x49 (2-3).\nAll channels are read single-ended (aquaPi driver): AIN0 on-board pH, AIN1 pH bias (monitor, allows\nAIN0-AIN1 differential later), AIN2 module input (0..5 V via divider), AIN3 general 0..3.3 V."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "d8ebef51-48ba-4f7d-9406-dd78662e5a74")
	)
