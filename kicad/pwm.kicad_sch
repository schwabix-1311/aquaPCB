	)
	(text "DC / LED ports: 2x4 box headers. Pin n = Robo-Tank v3 RJ45 pin n (pin 1 GND, 2..8 = 0-5 V PWM);\nRobo-Tank modules connect via an RJ45-to-box-header adapter cable wired 1:1."
		(exclude_from_sim no)
		(at 25.4 236.22 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "84cb245a-75e0-4270-9fe7-0e4355ae16b8")
	)
	(text "PCA9685 #1, I2C address 0x40. /OE fixed to GND: after power-on all outputs are LOW (datasheet 7.5);\na Pi reboot does NOT reset the chip - outputs keep their state until software re-initialises it. LED0, LED5 = spare."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
