	)
	(text "Box headers for the IDC DB9 adapter cable (wires 1..9 -> DB9 pins 1,6,2,7,3,8,4,9,5;\nDB9: 1..4 = Ch1..4, 5 = GND, 6..9 = Ch8..5 as Robo-Tank v3). Verify on the first sample."
		(exclude_from_sim no)
		(at 25.4 158.75 0)
		(effects
